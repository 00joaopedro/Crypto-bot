{
  "name": "crypto-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "strategy:validate": "node dist/validate-strategy-cli.js",
    "strategy:collect": "node dist/collect-okx-history-cli.js",
    "strategy:study": "node dist/strategy-study-cli.js",
    "demo:validation-report": "node dist/demo-validation-cli.js",
    "strategy:universe": "node dist/universe-study-cli.js",
    "strategy:universe-benchmark": "node dist/universe-scan-benchmark-cli.js",
    "execution:fidelity": "node dist/execution-fidelity-cli.js",
    "strategy:diagnose": "node dist/strategy-diagnostic-cli.js",
    "strategy:experiments": "node dist/limited-experiments-cli.js",
    "strategy:independent-readiness": "node dist/independent-validation-cli.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "ccxt": "^4.5.0",
    "dotenv": "^17.2.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
