{
  "name": "crypto-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "strategy:validate": "node dist/validate-strategy-cli.js",
    "strategy:collect": "node dist/collect-okx-history-cli.js",
    "strategy:study": "node dist/strategy-study-cli.js",
    "demo:validation-report": "node dist/demo-validation-cli.js",
    "strategy:universe": "node dist/universe-study-cli.js",
    "strategy:universe-benchmark": "node dist/universe-scan-benchmark-cli.js",
    "execution:fidelity": "node dist/execution-fidelity-cli.js",
    "execution:calibrate": "node dist/execution-calibration-cli.js",
    "strategy:diagnose": "node dist/strategy-diagnostic-cli.js",
    "strategy:experiments": "node dist/limited-experiments-cli.js",
    "strategy:independent-readiness": "node dist/independent-validation-cli.js",
    "strategy:complementary": "node dist/complementary-study-cli.js",
    "pilot:review": "node dist/pilot-review-cli.js",
    "strategy:cost-experiments": "node dist/cost-experiments-cli.js",
    "strategy:economics": "node dist/economic-diagnosis-cli.js",
    "strategy:pullback": "node dist/pullback-experiments-cli.js",
    "strategy:volatility-exits": "node dist/volatility-exit-experiments-cli.js",
    "strategy:confirmed-reversion": "node dist/confirmed-reversion-experiments-cli.js",
    "strategy:portfolio-readiness": "node dist/portfolio-readiness-cli.js",
    "strategy:refinement-readiness": "node dist/refinement-independent-readiness-cli.js",
    "account:inspect-readonly": "node dist/okx-read-only-inspection-cli.js",
    "strategy:hybrid-research": "node dist/hybrid-research-cli.js",
    "strategy:hybrid-collect": "node dist/hybrid-history-cli.js",
    "demo:hybrid-readiness": "node dist/hybrid-demo-readiness-cli.js",
    "demo:hybrid-shadow": "node dist/hybrid-shadow-cli.js",
    "demo:hybrid-audit": "node dist/hybrid-shadow-audit-cli.js",
    "strategy:hybrid-economic": "node dist/hybrid-economic-cli.js",
    "strategy:hybrid-economic-readiness": "node dist/hybrid-economic-readiness-cli.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "ccxt": "^4.5.0",
    "dotenv": "^17.2.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
