# Use DEMO only together with the explicit OKX Demo trading gate below.
# LIVE trading does not exist in this codebase.
ENVIRONMENT=LOG_ONLY

# Kraken supplies public candles because Bybit blocks Railway's available regions.
# This does not change the future execution venue.
MARKET_DATA_PROVIDER=kraken
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LIMIT=100
LOOP_DELAY_MS=60000

# Railway reference: ${{Postgres.DATABASE_URL}}
# Required when OKX Demo order execution is enabled.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Optional protected dashboard. Configure both values to expose it.
# Generate the secret with: openssl rand -hex 32
PORT=3000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Optional authenticated OKX Demo executor. It stays read-only by default.
# To submit virtual Spot orders, set ENVIRONMENT=DEMO and the demo gate=true.
EXECUTION_PROVIDER=disabled
LIVE_TRADING_ENABLED=false
OKX_DEMO_TRADING_ENABLED=false
OKX_DEMO_ORDER_SIZE_USDT=10
OKX_DEMO_STOP_LOSS_RATE=0.01
OKX_DEMO_TAKE_PROFIT_RATE=0.02
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional AI risk filter. Without it, BUY signals remain unapproved.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MIN_AI_CONFIDENCE=0.82
MIN_SIGNAL_SCORE=5

# Paper portfolio assumptions. Rates are decimal fractions.
PAPER_INITIAL_BALANCE_USDT=1000
PAPER_TRADE_SIZE_USDT=100
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
PAPER_STOP_LOSS_RATE=0.01
PAPER_TAKE_PROFIT_RATE=0.02

# Legacy credentials reserved for future Bybit execution in a supported region.
# Never commit real values.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
