# LOG_ONLY is the only mode accepted in this first safety milestone.
ENVIRONMENT=LOG_ONLY

# Kraken supplies public candles because Bybit blocks Railway's available regions.
# This does not change the future execution venue.
MARKET_DATA_PROVIDER=kraken
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LIMIT=100
LOOP_DELAY_MS=60000

# Optional AI risk filter. Without it, quantitative signals are logged as unapproved.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MIN_AI_CONFIDENCE=0.82

# Reserved for a future Bybit execution service in a supported hosting region.
# Never commit real values.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
