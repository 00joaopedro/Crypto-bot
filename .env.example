# Use DEMO only together with the explicit OKX Demo trading gate below.
# LIVE trading does not exist in this codebase.
ENVIRONMENT=LOG_ONLY

# OKX supplies the same venue's public candles used by Demo execution.
MARKET_DATA_PROVIDER=okx
# Optional fallback used only when the primary provider is unavailable.
MARKET_DATA_FALLBACK_PROVIDER=kraken
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LIMIT=100
LOOP_DELAY_MS=60000

# Railway reference: ${{Postgres.DATABASE_URL}}
# Required when OKX Demo order execution is enabled.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Optional protected dashboard. Configure both values to expose it.
# Generate the secret with: openssl rand -hex 32
PORT=3000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Optional authenticated OKX Demo executor. It stays read-only by default.
# To submit virtual Spot orders, set ENVIRONMENT=DEMO and the demo gate=true.
EXECUTION_PROVIDER=disabled
LIVE_TRADING_ENABLED=false
OKX_DEMO_TRADING_ENABLED=false
OKX_DEMO_ORDER_SIZE_USDT=10
OKX_DEMO_STOP_LOSS_RATE=0.01
OKX_DEMO_TAKE_PROFIT_RATE=0.02
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional AI risk filter. Without it, BUY signals remain unapproved.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MIN_AI_CONFIDENCE=0.82
MIN_SIGNAL_SCORE=5
SIGNAL_SCAN_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,ADA/USDT
DYNAMIC_UNIVERSE_SIZE=10
MARKET_MIN_QUOTE_VOLUME_USDT=1000000
MARKET_MAX_SPREAD_PERCENT=1
UNIVERSE_SWITCH_COOLDOWN_MINUTES=60
UNIVERSE_SWITCH_MIN_SCORE_ADVANTAGE=1
UNIVERSE_MAX_REPLACEMENTS=2

# Paper portfolio assumptions. Rates are decimal fractions.
PAPER_INITIAL_BALANCE_USDT=1000
PAPER_TRADE_SIZE_USDT=100
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
PAPER_STOP_LOSS_RATE=0.01
PAPER_TAKE_PROFIT_RATE=0.02
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_PROFIT_MULTIPLIER=3
ATR_MIN_STOP_RATE=0.005
ATR_MAX_STOP_RATE=0.03
# Initial safety profile: 20–30% aggregate exposure, max two positions.
RISK_MAX_EXPOSURE_PERCENT=0.25
MAX_CONCURRENT_POSITIONS=2
# Maximum estimated stop-loss risk per operation (1% of equity).
RISK_PER_TRADE_PERCENT=0.01
RISK_MAX_DAILY_LOSS_PERCENT=0.03
RISK_MAX_DRAWDOWN_PERCENT=0.10
# Hard-capped by config validation at five trades per hour.
RISK_MAX_TRADES_PER_HOUR=3
ENTRY_COOLDOWN_MINUTES=60
RISK_MAX_CONSECUTIVE_LOSSES=3
STOP_LOSS_COOLDOWN_MINUTES=60

# Legacy credentials reserved for future Bybit execution in a supported region.
# Never commit real values.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
